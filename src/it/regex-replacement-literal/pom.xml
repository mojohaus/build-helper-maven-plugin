<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.codehaus.mojo</groupId>
  <artifactId>build-helper-regex-replacement-literal-it</artifactId>
  <version>1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Literal regex replacements</name>
  <description>Tests literal replacement strings for issue #155 and default group substitution.</description>

  <properties>
    <windows.path>C:\projects\$1\target\</windows.path>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>@project.groupId@</groupId>
        <artifactId>@project.artifactId@</artifactId>
        <version>@project.version@</version>
        <executions>
          <execution>
            <id>literal-replacement</id>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>single.literal</name>
              <value>foo</value>
              <regex>^(.*)$</regex>
              <replacement>${windows.path}</replacement>
              <replacementLiteral>true</replacementLiteral>
            </configuration>
          </execution>
          <execution>
            <id>default-replacement</id>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>single.default</name>
              <value>foo</value>
              <regex>^(.*)$</regex>
              <replacement>$1-bar</replacement>
            </configuration>
          </execution>
          <execution>
            <id>empty-literal-replacement</id>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>single.empty</name>
              <value>foo</value>
              <regex>^.*$</regex>
              <replacementLiteral>true</replacementLiteral>
            </configuration>
          </execution>
          <execution>
            <id>multiple-replacements</id>
            <goals>
              <goal>regex-properties</goal>
            </goals>
            <configuration>
              <regexPropertySettings>
                <regexPropertySetting>
                  <name>multiple.literal</name>
                  <value>foo</value>
                  <regex>^(.*)$</regex>
                  <replacement>${windows.path}</replacement>
                  <replacementLiteral>true</replacementLiteral>
                </regexPropertySetting>
                <regexPropertySetting>
                  <name>multiple.default</name>
                  <value>foo</value>
                  <regex>^(.*)$</regex>
                  <replacement>$1-bar</replacement>
                </regexPropertySetting>
              </regexPropertySettings>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
