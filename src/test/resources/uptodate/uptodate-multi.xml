<project>
  <!-- the configuration of the former uptodate-multi integration test -->
  <build>
    <plugins>
      <plugin>
        <artifactId>build-helper-maven-plugin</artifactId>
        <configuration>
          <upToDatePropertySettings>
            <upToDatePropertySetting>
              <name>propname-flatten</name>
              <value>uptodate</value>
              <else>outofdate</else>
              <fileSet>
                <directory>${project.basedir}/src/main/resources/source</directory>
                <outputDirectory>${project.basedir}/src/main/resources/target/flatten</outputDirectory>
                <includes>
                  <include>dir*/**</include>
                </includes>
                <excludes>
                  <exclude>**/*X*</exclude>
                  <exclude>**/*Y/**</exclude>
                </excludes>
                <mapper>
                  <type>flatten</type>
                </mapper>
              </fileSet>
            </upToDatePropertySetting>
            <upToDatePropertySetting>
              <name>propname-glob</name>
              <value>uptodate</value>
              <else>outofdate</else>
              <fileSet>
                <directory>${project.basedir}/src/main/resources/source</directory>
                <outputDirectory>${project.basedir}/src/main/resources/target/glob</outputDirectory>
                <includes>
                  <include>dir*/**</include>
                </includes>
                <excludes>
                  <exclude>**/*X*</exclude>
                  <exclude>**/*Y/**</exclude>
                </excludes>
                <mapper>
                  <type>glob</type>
                  <from>*.s</from>
                  <to>*.t</to>
                </mapper>
              </fileSet>
            </upToDatePropertySetting>
            <upToDatePropertySetting>
              <name>propname-identity</name>
              <value>uptodate</value>
              <else>outofdate</else>
              <else>outofdate</else>
              <fileSet>
                <directory>${project.basedir}/src/main/resources/source</directory>
                <outputDirectory>${project.basedir}/src/main/resources/target/identity</outputDirectory>
                <includes>
                  <include>dir*/**</include>
                </includes>
                <excludes>
                  <exclude>**/*X*</exclude>
                  <exclude>**/*Y/**</exclude>
                </excludes>
              </fileSet>
            </upToDatePropertySetting>
            <upToDatePropertySetting>
              <name>propname-merge</name>
              <value>uptodate</value>
              <else>outofdate</else>
              <fileSet>
                <directory>${project.basedir}/src/main/resources/source</directory>
                <outputDirectory>${project.basedir}/src/main/resources/target/merge</outputDirectory>
                <includes>
                  <include>dir*/**</include>
                </includes>
                <excludes>
                  <exclude>**/*X*</exclude>
                  <exclude>**/*Y/**</exclude>
                </excludes>
                <mapper>
                  <type>merge</type>
                  <from>file*.s</from>
                  <to>todir/outfile.t</to>
                </mapper>
              </fileSet>
            </upToDatePropertySetting>
            <upToDatePropertySetting>
              <name>propname-package</name>
              <value>uptodate</value>
              <else>outofdate</else>
              <fileSet>
                <directory>${project.basedir}/src/main/resources/source</directory>
                <outputDirectory>${project.basedir}/src/main/resources/target/package</outputDirectory>
                <includes>
                  <include>dir*/**</include>
                </includes>
                <excludes>
                  <exclude>**/*X*</exclude>
                  <exclude>**/*Y/**</exclude>
                </excludes>
                <mapper>
                  <type>package</type>
                  <from>*.s</from>
                  <to>*.t</to>
                </mapper>
              </fileSet>
            </upToDatePropertySetting>
            <upToDatePropertySetting>
              <name>propname-unpackage</name>
              <value>uptodate</value>
              <else>outofdate</else>
              <fileSet>
                <directory>${project.basedir}/src/main/resources/source/unpackage</directory>
                <outputDirectory>${project.basedir}/src/main/resources/target/unpackage</outputDirectory>
                <includes>
                  <include>dir*.s</include>
                </includes>
                <excludes>
                  <exclude>*X*</exclude>
                  <exclude>*Y*</exclude>
                </excludes>
                <mapper>
                  <type>unpackage</type>
                  <from>*.s</from>
                  <to>*.t</to>
                </mapper>
              </fileSet>
            </upToDatePropertySetting>
          </upToDatePropertySettings>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
