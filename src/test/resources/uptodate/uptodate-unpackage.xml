<project>
  <!-- the configuration of the former uptodate-unpackage integration test -->
  <build>
    <plugins>
      <plugin>
        <artifactId>build-helper-maven-plugin</artifactId>
        <configuration>
          <name>propname-unpackage</name>
          <value>uptodate</value>
          <!-- Maven accepts the alias <else>; the plugin testing harness 3.5.1 only the field name -->
          <elseValue>outofdate</elseValue>
          <fileSet>
            <directory>${project.basedir}/src/main/resources/source</directory>
            <outputDirectory>${project.basedir}/src/main/resources/target</outputDirectory>
            <includes>
              <include>dir*.s</include>
            </includes>
            <excludes>
              <exclude>*X*</exclude>
              <exclude>*Y*</exclude>
            </excludes>
            <mapper>
              <type>unpackage</type>
              <from>*.s</from>
              <to>*.t</to>
            </mapper>
          </fileSet>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
